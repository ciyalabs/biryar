# Copy to .env and fill in. Everything here is read by both the API and the
# worker; docker-compose.yml passes them through.

# Required. Seals every tenant's Amazon credentials at rest. Generate one:
#   docker compose run --rm api python -c \
#     "from biryar.crypto import Keyring; print('v1:' + Keyring.generate_key())"
#
# Losing every key means every tenant must reauthorise. Keep it somewhere
# that is not this machine's disk.
#
# To rotate, put the new key first and keep the old one:
#   BIRYAR_SECRET_KEY=v2:<new>,v1:<old>
# Credentials move to the new key as each tenant is next used, so nothing
# has to be re-encrypted in one go.
BIRYAR_SECRET_KEY=

# The database password compose gives PostgreSQL.
POSTGRES_PASSWORD=biryar

# Where to publish the UI and API.
BIRYAR_PORT=8000

# -- Amazon -------------------------------------------------------------------
# From Seller Central's developer console. Without these, Biryar runs but no
# seller can connect an account, and the connect button says so rather than
# failing halfway through.

BIRYAR_AMAZON_APPLICATION_ID=
BIRYAR_LWA_CLIENT_ID=
BIRYAR_LWA_CLIENT_SECRET=

# Must match a redirect URI registered on the application exactly, or Amazon
# refuses the exchange with a message that does not say which end is wrong.
BIRYAR_AMAZON_REDIRECT_URI=http://localhost:8000/v1/amazon/callback

# true while the application is in Draft. Amazon requires version=beta on the
# consent URL then and rejects it once published, so this flips at the same
# time the application does.
BIRYAR_AMAZON_APPLICATION_IS_DRAFT=true
