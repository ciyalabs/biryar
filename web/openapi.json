      "Marketplace": {
        "description": "The Amazon marketplaces Biryar understands.\n\nA short list on purpose. Each one implies a currency, a VAT regime and a\nset of fee paths, and claiming support for a marketplace whose fee\nstructure has never been read against real settlement data would be a\nclaim the product cannot keep.",
        "enum": [
          "A1PA6795UKMFR9",
          "A1F83G8C2ARO7P",
          "A13V1IB3VIYZZH",
          "APJ6JRA9NG5V4",
          "A1RKKUPIHCS9HS",
          "A1805IZSGTT6HS",
          "ATVPDKIKX0DER"
        ],
        "title": "Marketplace",
        "type": "string"
      },
      "PeriodResponse": {
        "description": "The bottom line for a window.",
        "properties": {
          "cogs": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Negative. Null while nothing sold has a cost on record.",
            "title": "Cogs"
          },
          "end": {
            "format": "date",
            "title": "End",
            "type": "string"
          },
          "gross_contribution": {
            "description": "Revenue less Amazon and the carrier. Always knowable.",
            "title": "Gross Contribution",
            "type": "string"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "number"
          },
          "net_profit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null while any sold unit is unpriced, rather than counting that unit as free.",
            "title": "Net Profit"
          },
          "orders": {
            "title": "Orders",
            "type": "integer"
          },
          "overhead": {
            "description": "Negative. Subscription and inbound freight, kept as period cost rather than pushed onto whichever SKUs happened to sell.",
            "title": "Overhead",
            "type": "string"
          },
          "postage": {
            "description": "Negative: what the carrier kept.",
            "title": "Postage",
            "type": "string"
          },
          "revenue": {
            "title": "Revenue",
            "type": "string"
          },
          "selling_fees": {
            "description": "Negative: what Amazon kept.",
            "title": "Selling Fees",
            "type": "string"
          },
          "skus_missing_cost": {
            "items": {
              "type": "string"
            },
            "title": "Skus Missing Cost",
            "type": "array"
          },
          "start": {
            "format": "date",
            "title": "Start",
            "type": "string"
          },
          "units": {
            "title": "Units",
            "type": "integer"
          },
          "units_without_cost": {
            "title": "Units Without Cost",
            "type": "integer"
          }
        },
        "required": [
          "start",
          "end",
          "units",
          "orders",
          "revenue",
          "selling_fees",
          "postage",
          "cogs",
          "overhead",
          "gross_contribution",
          "net_profit",
          "units_without_cost",
          "skus_missing_cost",
          "latency_ms"
        ],
        "title": "PeriodResponse",
        "type": "object"
      },
      "Role": {
        "description": "What a user may do inside their tenant.\n\nDeliberately two. The platform has exactly one dangerous category of\naction \u2014 anything that reaches Amazon, a buyer, a supplier or money \u2014 and\na role system with five tiers invites the question of which tier may do\nhalf of it. An owner may approve; an assistant may prepare.",
        "enum": [
          "owner",
          "assistant"
        ],
        "title": "Role",
        "type": "string"
      },
      "SelfAuthorisation": {
        "description": "A refresh token the owner obtained by authorising their own app.\n\nThe token is write-only: it is sealed on arrival and no route ever\nreturns it, so this model has no response counterpart carrying it back.",
        "properties": {
          "marketplace": {
            "$ref": "#/components/schemas/Marketplace",
            "default": "A1PA6795UKMFR9"
          },
          "refresh_token": {
            "description": "The Atzr|... token the Solution Provider Portal showed after you authorised the application against your own account.",
            "minLength": 1,
            "title": "Refresh Token",
            "type": "string"
          },
          "selling_partner_id": {
            "description": "Your merchant token, shown beside the authorisation.",
            "minLength": 1,
            "title": "Selling Partner Id",
            "type": "string"
          }
        },
        "required": [
          "selling_partner_id",
          "refresh_token"
        ],
        "title": "SelfAuthorisation",
        "type": "object"
      },
      "SettlementFileReport": {
        "description": "What one downloaded settlement report says.\n\nDeliberately stateless: nothing is stored. A settlement file and the\nFinances feed describe the same money in different shapes, and merging\nthem would risk counting a period twice \u2014 the exact failure the ledger\nwas once wrong about. So this answers a question and keeps nothing.\n\nThat also makes it the thing to try first: it needs no Amazon\napplication, no developer registration and no connected account.",
        "properties": {
          "cogs": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cogs"
          },
          "counted_total": {
            "description": "Every amount in the file, added up.",
            "title": "Counted Total",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "deposit_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deposit Date"
          },
          "difference": {
            "title": "Difference",
            "type": "string"
          },
          "gross_contribution": {
            "title": "Gross Contribution",
            "type": "string"
          },
          "latency_ms": {
            "title": "Latency Ms",
            "type": "number"
          },
          "net_profit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Net Profit"
          },
          "orders": {
            "title": "Orders",
            "type": "integer"
          },
          "overhead": {
            "title": "Overhead",
            "type": "string"
          },
          "period_end": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period End"
          },
          "period_start": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period Start"
          },
          "reconciles": {
            "description": "Whether the two agree. False means the file was read wrong and the figures below should not be trusted \u2014 not that a fee is unrecognised, since unrecognised amounts are still counted.",
            "title": "Reconciles",
            "type": "boolean"
          },
          "revenue": {
            "title": "Revenue",
            "type": "string"
          },
          "rows_read": {
            "title": "Rows Read",
            "type": "integer"
          },
          "selling_fees": {
            "title": "Selling Fees",
            "type": "string"
          },
          "settlement_id": {
            "title": "Settlement Id",
            "type": "string"
          },
          "skus_missing_cost": {
            "items": {
              "type": "string"
            },
            "title": "Skus Missing Cost",
            "type": "array"
          },
          "stated_total": {
            "description": "The payout Amazon states in the file's summary row.",
            "title": "Stated Total",
            "type": "string"
          },
          "units": {
            "title": "Units",
            "type": "integer"
          },
          "units_without_cost": {
            "title": "Units Without Cost",
            "type": "integer"
          },
          "unmapped": {
            "description": "Amazon publishes this report's column names but not the values of amount-type and amount-description, so some fees will be unfamiliar. They are listed rather than dropped.",
            "items": {
              "$ref": "#/components/schemas/UnmappedAmount"
            },
            "title": "Unmapped",
            "type": "array"
          }
        },
        "required": [
          "settlement_id",
          "period_start",
          "period_end",
          "deposit_date",
          "currency",
          "stated_total",
          "counted_total",
          "reconciles",
          "difference",
          "rows_read",
          "units",
          "orders",
          "revenue",
          "selling_fees",
          "cogs",
          "overhead",
          "gross_contribution",
          "net_profit",
          "units_without_cost",
          "skus_missing_cost",
          "unmapped",
          "latency_ms"
        ],
        "title": "SettlementFileReport",
        "type": "object"
      },
