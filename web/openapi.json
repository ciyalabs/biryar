{
  "components": {
    "schemas": {
      "AuthorisationStart": {
        "properties": {
          "marketplace": {
            "$ref": "#/components/schemas/Marketplace"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "marketplace"
        ],
        "title": "AuthorisationStart",
        "type": "object"
      },
      "ConnectionStatus": {
        "properties": {
          "connected": {
            "title": "Connected",
            "type": "boolean"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "marketplace": {
            "$ref": "#/components/schemas/Marketplace"
          },
          "oauth_available": {
            "default": false,
            "description": "Whether this installation has an Amazon application configured, and so can send a seller through the consent flow. False on a self-hosted install, where a private application has no OAuth configuration and the consent URL answers MD9100 \u2014 the interface offers self-authorisation instead of a button that cannot work.",
            "title": "Oauth Available",
            "type": "boolean"
          },
          "selling_partner_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selling Partner Id"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "required": [
          "marketplace",
          "connected"
        ],
        "title": "ConnectionStatus",
        "type": "object"
      },
      "CostBasisResponse": {
        "properties": {
          "rows": {
            "items": {
              "$ref": "#/components/schemas/CostRow"
            },
            "title": "Rows",
            "type": "array"
          },
          "skus": {
            "title": "Skus",
            "type": "integer"
          }
        },
        "required": [
          "rows",
          "skus"
        ],
        "title": "CostBasisResponse",
        "type": "object"
      },
      "CostImportResponse": {
        "description": "What an import did, including what it could not read.\n\n``skipped`` is the field that matters. Parsing continues past a bad row\nso that one typo does not cost the other two hundred lines, which means\nthe only way a seller learns that thirty rows were dropped is if the\nresponse says so. Thirty dropped rows are thirty SKUs with no cost, and\nan unpriced SKU does not raise anything \u2014 it quietly leaves `net_profit`\nunanswerable and the floor for that SKU unknown.",
        "properties": {
          "invoices": {
            "title": "Invoices",
            "type": "integer"
          },
          "recorded": {
            "description": "Cost entries written or corrected.",
            "title": "Recorded",
            "type": "integer"
          },
          "skipped": {
            "items": {
              "$ref": "#/components/schemas/SkippedRowResponse"
            },
            "title": "Skipped",
            "type": "array"
          },
          "unmatchable": {
            "description": "Keys stored from a line with no sku column. The Finances feed reports your seller SKU and never a supplier's EAN or article number, so a cost keyed on one of those is kept but will not be found by any sale. Add a sku column and import again.",
            "items": {
              "type": "string"
            },
            "title": "Unmatchable",
            "type": "array"
          }
        },
        "required": [
          "recorded",
          "invoices",
          "skipped"
        ],
        "title": "CostImportResponse",
        "type": "object"
      },
      "CostRow": {
        "description": "One unit cost in force from a date.",
        "properties": {
          "effective_from": {
            "format": "date",
            "title": "Effective From",
            "type": "string"
          },
          "note": {
            "default": "",
            "title": "Note",
            "type": "string"
          },
          "sku": {
            "title": "Sku",
            "type": "string"
          },
          "source": {
            "default": "",
            "title": "Source",
            "type": "string"
          },
          "unit_cost": {
            "title": "Unit Cost",
            "type": "string"
          }
        },
        "required": [
          "sku",
          "effective_from",
          "unit_cost"
        ],
        "title": "CostRow",
        "type": "object"
      },
      "ForgetResponse": {
