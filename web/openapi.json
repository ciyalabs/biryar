            "title": "Contribution"
          },
          "orders": {
            "title": "Orders",
            "type": "integer"
          },
          "postage": {
            "title": "Postage",
            "type": "string"
          },
          "revenue": {
            "title": "Revenue",
            "type": "string"
          },
          "selling_fees": {
            "title": "Selling Fees",
            "type": "string"
          },
          "sku": {
            "title": "Sku",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "units": {
            "title": "Units",
            "type": "integer"
          },
