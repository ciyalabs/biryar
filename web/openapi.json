    "/v1/costs/import": {
      "post": {
        "description": "Read a cost file and store the landed unit costs it implies.\n\nRe-importing the same file is safe: a cost for a SKU on a date replaces\nthe one held for that date rather than adding a second lot. That matters\nbecause an import is exactly the kind of thing someone runs twice when\nthey are not sure the first one worked.",
        "operationId": "import_costs_v1_costs_import_post",
        "requestBody": {
          "content": {
            "text/csv": {
              "schema": {
                "description": "The cost file, as CSV text. Required columns: vendor, doc_number, doc_date, name, qty, unit_price. Optional: sku (your Amazon SKU \u2014 without it a cost cannot be matched to a sale), ean, article_no, shipping, prices_include_vat, vat_rate.",
                "title": "Csv Text",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CostImportResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "Session token": []
          }
        ],
        "summary": "Import Costs",
        "tags": [
          "costs"
        ]
      }
    },
