  "info": {
    "summary": "Amazon operations, one decision at a time.",
    "title": "Biryar",
    "version": "0.1.0.dev0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/amazon/authorize": {
      "post": {
        "description": "Where to send this tenant's seller to approve the application.",
        "operationId": "authorize_v1_amazon_authorize_post",
        "parameters": [
          {
            "in": "query",
            "name": "marketplace",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Marketplace",
              "default": "A1PA6795UKMFR9"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorisationStart"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "Session token": []
          }
        ],
        "summary": "Authorize",
        "tags": [
          "amazon"
        ]
      }
    },
    "/v1/amazon/callback": {
      "get": {
        "description": "Where Amazon returns the seller, carrying a code worth five minutes.\n\nUnauthenticated by necessity; the state is what proves whose account this\nis. See the module docstring.",
        "operationId": "callback_v1_amazon_callback_get",
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": true,
            "schema": {
              "title": "State",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "spapi_oauth_code",
            "required": true,
            "schema": {
              "title": "Spapi Oauth Code",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "selling_partner_id",
            "required": true,
            "schema": {
              "title": "Selling Partner Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "marketplace",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Marketplace",
              "default": "A1PA6795UKMFR9"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Callback",
        "tags": [
          "amazon"
        ]
      }
    },
    "/v1/amazon/credentials": {
      "post": {
        "description": "Accept a refresh token from the portal's self-authorisation.\n\nOwner-only: this is the credential that reads the seller's finances.\n\nDeliberately permissive about the token's shape beyond being non-empty.\nAmazon's refresh tokens have looked like ``Atzr|...`` for years, but\nrejecting anything else here would turn a format change into \"Biryar is\nbroken\" rather than a clear error from Amazon on first use \u2014 and the\nfirst use is seconds away, in the settlement job.",
        "operationId": "store_self_authorisation_v1_amazon_credentials_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelfAuthorisation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "Session token": []
          }
        ],
        "summary": "Store Self Authorisation",
        "tags": [
          "amazon"
        ]
      }
    },
    "/v1/amazon/status": {
      "get": {
        "description": "Whether this tenant can currently reach Amazon.\n\nA seller whose authorisation was revoked needs to be told on their own\nscreen. Finding out because the numbers quietly stopped moving is the\nfailure this exists to prevent.",
